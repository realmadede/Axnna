{
  "name": "axnna-web",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 migrations apply DB --local",
    "test": "vitest run",
    "test:live": "./node_modules/.bin/esbuild scripts/verify_live_provider.ts --bundle --platform=node --format=esm --outfile=.wrangler/verify_live_provider.mjs && node .wrangler/verify_live_provider.mjs"
  },
  "dependencies": {
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.52.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240208.0",
    "@testing-library/react": "^14.3.1",
    "@types/node": "^26.6.4",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.26",
    "jsdom": "^24.1.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.21",
    "vitest": "^1.6.1",
    "wrangler": "^3.28.1"
  }
}
