# Cloudflare Worker Local Secrets:
# Copy active Worker secrets into `axnna-web/.dev.vars` for `wrangler dev --local`,
# and upload them to production with `npx wrangler secret put <KEY>` inside `axnna-web/`.
# Note: Macro economic calendar uses a free keyless feed (no Finnhub paid key required).

# TwelveData API Key for Market Data (5M & 1H candles)
TWELVEDATA_API_KEY="your_twelvedata_key_here"

# Telegram Bot Token
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"

# Admin Passphrase for /config login
ADMIN_PASSPHRASE="your_admin_passphrase"

# Optional Bearer Secret for POST /api/dev/backtest
BACKTEST_SECRET="your_backtest_secret"
